status is-login; and begin

{{ if eq .chezmoi.os "darwin" }}
    # Bootstrap Homebrew environment
    # /opt/homebrew/bin/brew shellenv | source
{{ end }}

    # Source Nix profile if installed
    if test -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.fish'
        source '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.fish'
    end

end

status is-interactive; and begin

    # Disable the default greeting message
    set fish_greeting

    # Theme
    fish_config theme choose catppuccin-frappe --color-theme=dark

    # Use vim key bindings
    fish_vi_key_bindings
    bind -M insert \cr history-pager
    bind -M default yy fish_clipboard_copy
    bind -M default Y begin-selection end-of-line fish_clipboard_copy end-selection

    # Required by GPG agent for passphrase prompts in the terminal
    set -x GPG_TTY (tty)

    # Set nvim as the default editor
    set -x EDITOR nvim
    set -x VISUAL nvim

    # Render Claude Code in the alternate screen buffer (fullscreen, no flicker)
    set -x CLAUDE_CODE_NO_FLICKER 1

    # Prompt
    if test "$TERM" != dumb
        starship init fish | source
    end

    # Auto-load/unload .envrc on directory change
    direnv hook fish | source

    # Auto-load/unload devenv on directory change
    devenv hook fish | source

    # Auto-start tmux on interactive shells outside tmux
    if not set -q TMUX
        tmux attach 2>/dev/null; or tmux new-session -s default -c ~
    end

    # Record the running command ("-" when idle) in a pane-scoped @winname
    # option; winname.sh joins the non-idle panes into the window name so a
    # window shows everything running across its panes (e.g. "claude | nvim").
    # We stash it per pane rather than calling `tmux rename-window` directly so
    # the name tracks pane switches/closes via tmux's window-layout-changed hook
    # (see tmux.conf), and we set @winname ourselves rather than letting
    # automatic-rename read pane_current_command because devenv's auto-activation
    # subshell hides the real command from it. The regex grabs just the leading
    # program token (stopping at whitespace or a shell metacharacter) so a piped
    # command like `cat foo | grep bar` records as "cat", never leaking a literal
    # pipe into the name. `type -q tmux` guards the case where the tmux binary
    # isn't on PATH inside a devenv env — then we just no-op.
    if set -q TMUX; and type -q tmux
        function _tmux_winname --on-event fish_preexec
            if string match -rq -- '^\s*(?<prog>[^\s|&;<>()]+)' $argv[1]
                tmux set -p @winname (path basename -- $prog) 2>/dev/null
            end
            ~/.config/tmux/scripts/winname.sh 2>/dev/null
        end
        function _tmux_winname_idle --on-event fish_postexec
            tmux set -p @winname - 2>/dev/null
            ~/.config/tmux/scripts/winname.sh 2>/dev/null
        end
        tmux set -p @winname - 2>/dev/null
        ~/.config/tmux/scripts/winname.sh 2>/dev/null
    end
end
